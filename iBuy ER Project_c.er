{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":null,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":45,"erCode":"/* Entities */\nentity UTENTE {\n    username (id),\n    mail,\n    password,\n    imm_Profilo (optional),\n    Indirizzo (optional) {\n        via (optional),\n        numero_Civico (optional),\n        citta (optional),\n        CAP (optional)\n    }\n}\nentity VENDITORE {\n    partita_Iva\n}\nentity PRODOTTO {\n    nome (id),\n    descrizione,\n    costo,\n    timestamp (id),\n    quantita (optional),\n    immagine (optional)\n}\nentity PRODOTTO_DIGITALE {\n    dimensione\n}\nentity PRODOTTO_FISICO {\n    peso\n}\nentity ACQUISTO {\n    timestamp (external),\n    costo\n}\n\n/* Relationships */\nrelationship VENDE (\n    VENDITORE: zero..many,\n    PRODOTTO: one..one\n)\nrelationship EFFETTUA (\n    UTENTE: zero..many,\n    ACQUISTO: one..one external\n)\nrelationship CONTIENE (\n    ACQUISTO: one..one external,\n    PRODOTTO: zero..many\n)\nrelationship SEGUE (\n    UTENTE: zero..many,\n    VENDITORE: zero..many\n)\n\n/* Generalizations */\nUTENTE <= {\n    VENDITORE\n} (partial, exclusive)\nPRODOTTO <= {\n    PRODOTTO_DIGITALE,\n    PRODOTTO_FISICO\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"UTENTE","_x":-146,"_y":-384,"_mag":false},{"__type":"Attribute","_id":2,"_name":"username","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-140,"_y":0},{"__type":"Attribute","_id":3,"_name":"mail","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-164,"_y":-38},{"__type":"Attribute","_id":5,"_name":"password","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-138,"_y":42},{"__type":"Attribute","_id":6,"_name":"imm_Profilo","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":-116,"_y":-